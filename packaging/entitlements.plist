<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Release entitlements for the hardened runtime. No microphone, no
       camera, no get-task-allow (release-build.sh fails if that one is ever
       found in a signed engine). -->

  <!-- The two network keys are App Sandbox keys. The app is not sandboxed,
       so they have no effect today: the engine may open client and server
       sockets without them. They are kept so that the intent (multiplayer,
       the content downloader, hosting a LAN game) is already declared if the
       app is ever sandboxed. -->
  <key>com.apple.security.network.client</key><true/>
  <key>com.apple.security.network.server</key><true/>

  <!-- Library validation stays ON (false = not disabled) for a Developer ID
       build: every dylib in the bundle is signed by the same team, so the
       graphics driver and SDL load without a relaxation. An ad-hoc build has
       no team, so release-build.sh rewrites this value to true for ad-hoc
       signing only. -->
  <key>com.apple.security.cs.disable-library-validation</key><false/>
</dict>
</plist>
